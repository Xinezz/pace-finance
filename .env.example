# Copy this file to `.env.local` and fill in the two values from your Supabase project
# (the "Connect" button on the project page, or Settings -> API Keys).
# `.env.local` is git-ignored, so it never reaches GitHub.
#
# Leave both blank to run Pace in local-only mode (no accounts; data stays in the browser).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLISHABLE key: starts with sb_publishable_
# It is designed to be visible to browsers; Row Level Security (supabase/migrations) keeps each
# person's data private. (An older project's legacy "anon" key also works here.)
#
# NEVER paste a secret key (sb_secret_...) or the legacy service_role key. Pace refuses to start with one.
VITE_SUPABASE_PUBLISHABLE_KEY=
