# Copy this file to `.env.local` and fill in the two values from your Supabase project
# (Project Settings -> API). `.env.local` is git-ignored, so it never reaches GitHub.
#
# Leave both blank to run Pace in local-only mode (no accounts; data stays in the browser).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLIC "anon" key. It is designed to be exposed to browsers; Row Level Security
# (see supabase/migrations) is what keeps each person's data private.
#
# NEVER paste the "service_role" key here or anywhere else in this project.
VITE_SUPABASE_ANON_KEY=
